APP_NAME="Metal Live"
APP_URL=http://localhost:8000
APP_DEBUG=false
APP_TIMEZONE=America/Argentina/Buenos_Aires
# Generar con: php -r 'echo bin2hex(random_bytes(32));'
APP_KEY=
# Solo si la app corre detrás de un proxy/balanceador que termina HTTPS.
TRUST_PROXY=false
SESSION_IDLE_MINUTES=60

# sqlite (por defecto, sin instalación) o mysql
DB_CONNECTION=sqlite
DB_DATABASE=storage/database.sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=metal_live
# DB_USERNAME=metal_live
# DB_PASSWORD=

# Usuario administrador inicial (bin/migrate.php). Si no hay contraseña, se genera una.
ADMIN_EMAIL=admin@metallive.com.ar
ADMIN_PASSWORD=

UPLOAD_MAX_MB=10

# Motor de avisos
NOTIFY_CHANNELS=email,whatsapp
# true = los avisos se envían con el worker bin/notify.php (cron); false = al momento
NOTIFY_QUEUE=false
DELIVERY_LINK_DAYS=5

# Correo: log (guarda .eml en storage/mail) | smtp | mail
MAIL_DRIVER=log
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=avisos@metallive.com.ar
MAIL_FROM_NAME="Metal Live"

# WhatsApp Business Cloud API (opcional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v21.0

# Datos de contacto del sitio
SITE_PHONE="+54 11 5264 2763"
SITE_URGENT_PHONE="+54 11 4448 7396"
SITE_WHATSAPP=5491144487396
SITE_WHATSAPP_LABEL="+54 11 4448 7396"
SITE_EMAIL=info@metallive.com.ar
SITE_ADDRESS="Av. Amancio Alcorta 3711, CABA, Argentina"
